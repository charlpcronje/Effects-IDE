{
  "name": "fx-generator",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-net --allow-run src/main.ts",
    "build": "deno compile --allow-read --allow-write --allow-net --allow-run --output fx src/main.ts",
    "build:windows": "deno compile --target x86_64-pc-windows-msvc --allow-read --allow-write --allow-net --allow-run --output fx.exe src/main.ts",
    "build:macos": "deno compile --target x86_64-apple-darwin --allow-read --allow-write --allow-net --allow-run --output fx-macos src/main.ts",
    "build:linux": "deno compile --target x86_64-unknown-linux-gnu --allow-read --allow-write --allow-net --allow-run --output fx-linux src/main.ts",
    "test": "deno test --allow-read --allow-write"
  },
  "imports": {
    "@cliffy/prompt": "https://deno.land/x/cliffy@v1.0.0-rc.3/prompt/mod.ts",
    "@std/path": "https://deno.land/std@0.208.0/path/mod.ts",
    "@std/fs": "https://deno.land/std@0.208.0/fs/mod.ts",
    "@std/fmt": "https://deno.land/std@0.208.0/fmt/colors.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.unstable"]
  }
}
