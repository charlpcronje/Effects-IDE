{
  "name": "fx-dreamweaver",
  "version": "1.0.0",
  "description": "FX Dreamweaver 3D IDE - Spatial Visual Code Studio",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && npm run copy-assets && npm run build:bundle",
    "copy-assets": "node -e \"require('fs').cpSync('src/renderer/index.html', 'dist/renderer/index.html')\"",
    "build:bundle": "node scripts/build-bundle.js",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "start": "electron .",
    "package": "electron-builder",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "@types/node": "^20.10.0",
    "@types/three": "^0.160.0"
  },
  "build": {
    "appId": "com.fx.dreamweaver",
    "productName": "FX Dreamweaver",
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
